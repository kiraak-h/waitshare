# ============================================================================
# WaitShare — server configuration
# Copy to .env (or export in your shell / platform) and fill in real values.
# ============================================================================

# --- runtime ---------------------------------------------------------------
NODE_ENV=development            # production disables demo seeding and enables warnings
PORT=3001
HOST=0.0.0.0
DATA_DIR=./server/data          # SQLite data dir (dev). Unused when DATABASE_URL is set.
# DATABASE_URL=postgres://user:pass@host:5432/waitshare   # set to run natively on Postgres
# PG_SCHEMA_PATH=./server/migrations/001_init.sql          # optional override (default is the bundled schema)
PUBLIC_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
# TRUST_PROXY=1                 # honor X-Forwarded-For (behind a reverse proxy). Set to 0 when the API is directly exposed.

# --- demo seeding ----------------------------------------------------------
# Set to 0 in production. Demo advertiser + campaigns are created when enabled.
SEED_DEMO=1
# DEMO_DEV_EMAIL=demo@waitshare.dev

# --- admin (signed update publishing) --------------------------------------
# Required to publish update manifests/artifacts. Empty = publishing disabled.
ADMIN_TOKEN=change-me-in-production

# --- Stripe ----------------------------------------------------------------
# dev: leave STRIPE_MODE=stub to exercise the whole marketplace without keys.
# prod: STRIPE_MODE=live with a real secret key + webhook secret.
STRIPE_MODE=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google OAuth (developer sign-in) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- payouts ---------------------------------------------------------------
PAYMENT_THRESHOLD_CENTS=1000    # minimum available balance before a payout request
PAYOUT_HOLD_MS=259200000        # 72h clearing window (held -> cleared)
RESERVE_PCT=10                  # % of each dev share held as clawback reserve
RESERVE_RELEASE_MS=2592000000   # 30d until reserve releases back to balance
SWEEP_INTERVAL_MS=60000         # held-payout / reserve sweeper tick

# --- impression quality + caps ---------------------------------------------
MIN_IMPRESSION_SECONDS=10
MIN_VIEWABLE_PCT=50
MIN_FOCUS_PCT=0
MIN_GAP_MS=0
MAX_PENDING_SERVES=2
SERVE_TTL_MS=90000
CAP_HOURLY=60
CAP_DAILY=600

# --- fraud tier 2 (fleet-wide network detection) ----------------------------
# FRAUD_SALT: optional fixed salt for IP hashing. Unset = per-instance salt is
# generated and persisted under DATA_DIR (rotate loses cross-instance history).
FRAUD_SALT=
TIER2_FARM_DEVS=5               # distinct devs per masked network in window = farm
TIER2_VPN_NETWORKS=3            # distinct networks per dev in window = vpn rotation
TIER2_WINDOW_MS=86400000        # 24h signal window
TIER2_DC_ENFORCE=1              # withhold serves from datacenter/cloud IPs (0 disables)
ASN_DB_PATH=                    # optional JSON asn dataset override (default: server/assets/asn.json)

# --- fraud tier 3 (risk scoring + graduated trust) ---------------------------
TIER3_HIGH_RISK=75              # score >= this rejects the impression
TIER3_REVIEW=55                 # score >= this logs a review event (not rejected)
TIER3_MODEL_PATH=               # optional risk-model JSON override (default: server/assets/risk-model.json)
TRUST_ESTABLISHED_IMPRESSIONS=50  # impressions to exit the new-account tier
TRUST_ESTABLISHED_DAYS=7        # days to exit the new-account tier
TRUST_TRUSTED_IMPRESSIONS=2000  # impressions to reach the trusted tier
TRUST_TRUSTED_DAYS=30           # days to reach the trusted tier
TIER0_CAP_HOURLY=20             # new-account hourly cap
TIER0_CAP_DAILY=100             # new-account daily cap
TIER0_PAYOUT_CAP_CENTS=10000    # new-account max single payout before review

# --- clients ----------------------------------------------------------------
# Read by the opencode / claude-code / vscode client surfaces.
WAITSHARE_API=http://localhost:3001/api/v1
WAITSHARE_HOME=~/.waitshare
WAITSHARE_COUNTRY=US
